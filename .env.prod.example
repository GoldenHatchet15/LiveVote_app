# ---- LiveVote PRODUCTION environment (Cloudflare Tunnel) ----
# Copy to .env next to docker-compose.prod.yml. NEVER commit the real .env.

# Public URL players and the host use (encoded in the QR code).
PUBLIC_BASE_URL=https://livevote.jrcodestudio.org

# Allowed origins for the API + Socket.IO layer. Just the public URL in prod.
CORS_ORIGINS=https://livevote.jrcodestudio.org

# Admin auth — PREFER the hash. Generate it with:
#   npm run hash-password -w server -- 'your-strong-password'
# Then paste the scrypt$... value here and leave ADMIN_PASSWORD blank.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Cookie signing secret — generate a fresh long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels → (your tunnel).
TUNNEL_TOKEN=

# Privacy: auto-delete a session's player data after this many days.
DATA_RETENTION_DAYS=30
