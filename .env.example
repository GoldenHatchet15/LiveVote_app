# ---- LiveVote environment ----
# Copy to .env and adjust. NEVER commit your real .env.

# Admin password that protects /admin and /host.
# PRODUCTION: prefer a hashed password (ADMIN_PASSWORD_HASH) and leave this blank.
# DEV: a plaintext password is fine.
ADMIN_PASSWORD=changeme

# Hashed admin password (preferred in production). scrypt, no plaintext stored.
# Generate with:  npm run hash-password -w server -- 'your-strong-password'
# Then set ADMIN_PASSWORD_HASH to the printed value and clear ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-me-to-a-long-random-string

# Set to 'true' ONLY when running behind Cloudflare (or another trusted proxy);
# the real client IP is then read from CF-Connecting-IP. Never enable otherwise.
TRUST_PROXY=false

# Privacy: auto-delete a session's player data after this many days.
DATA_RETENTION_DAYS=30

# Abuse caps.
MAX_PLAYERS_PER_SESSION=300
MAX_ACTIVE_SESSIONS=100

# HTTP port the server listens on (also serves the built client in production).
PORT=3000

# Prisma / SQLite database location (relative to server/prisma).
DATABASE_URL="file:./dev.db"

# Public base URL players use to join (shown as the join URL + encoded in the QR code).
# For local play on the same Wi-Fi, set this to your laptop's LAN IP, e.g. http://192.168.1.42:3000
# For Cloudflare Tunnel, set it to your tunnel URL, e.g. https://livevote.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins for the Socket.IO / API layer.
# In dev the Vite client runs on 5173; in production the client is served from PORT.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Node environment: development | production
NODE_ENV=development
